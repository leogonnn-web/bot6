# Bybit API credentials (NEVER commit real keys)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Bybit Demo Trading credentials (api-demo.bybit.com, separate account).
# Used instead of the keys above when exchange.demo_trading=true in config.json.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Real-money safety switch. With dry_run=false AND demo_trading=false the bot
# refuses to start unless this is exactly "yes" (exit code 2).
HYDRA_LIVE_CONFIRM=

# Healthcheck ping URL (e.g. healthchecks.io)
HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# Grafana admin password
GRAFANA_PASSWORD=change_me_in_production

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
